# /etc/slurm-monitor/exporter.env
#
# Environment overrides for the slurm-monitor-exporter systemd unit.
# Copy this file to /etc/slurm-monitor/exporter.env and edit. Values not set
# here fall back to the defaults baked into the .service file.

# Bind address. Use 127.0.0.1 if Prometheus reaches the node via SSH tunnel.
SLURM_MONITOR_SERVER_BIND_HOST=0.0.0.0
SLURM_MONITOR_SERVER_BIND_PORT=9817

# slurmrestd endpoint. Albedo runs slurmrestd locally on each login node.
SLURM_MONITOR_SLURM_BASE_URL=http://127.0.0.1:6820
SLURM_MONITOR_SLURM_CLUSTER=albedo
# SLURM_MONITOR_SLURM_API_VERSION=v0.0.39    # uncomment to pin

# JWT auth.
SLURM_MONITOR_AUTH_USER=slurm
SLURM_MONITOR_AUTH_TOKEN_FILE=/run/slurm-monitor/jwt

# Logging.
SLURM_MONITOR_SERVER_LOG_LEVEL=INFO
SLURM_MONITOR_SERVER_LOG_JSON=true

# Polling intervals (seconds). Defaults are fine for ~240 nodes.
# SLURM_MONITOR_INTERVAL_NODES_SECONDS=20
# SLURM_MONITOR_INTERVAL_JOBS_SECONDS=30
# SLURM_MONITOR_INTERVAL_PARTITIONS_SECONDS=60
# SLURM_MONITOR_INTERVAL_DIAG_SECONDS=30
# SLURM_MONITOR_INTERVAL_RESERVATIONS_SECONDS=120
