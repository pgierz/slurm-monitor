# /etc/slurm-monitor/tunnel.env
#
# Reverse SSH tunnel settings for the optional autossh-based fallback.
# Only used if the monitoring VM cannot reach the login node directly.

LOCAL_PORT=9817
REMOTE_BIND=127.0.0.1
REMOTE_PORT=19817
MONITORING_HOST=monitor.albedo.example.awi.de
SSH_USER=slurm-monitor
SSH_KEY=/etc/slurm-monitor/tunnel_id_ed25519
