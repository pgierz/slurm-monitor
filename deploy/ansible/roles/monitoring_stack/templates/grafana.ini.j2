{{ ansible_managed | comment }}
[server]
http_port = {{ monitoring_grafana_listen_port }}
{% if monitoring_grafana_root_url %}
root_url = {{ monitoring_grafana_root_url }}
{% endif %}

[security]
admin_user = {{ monitoring_grafana_admin_user }}
admin_password = {{ monitoring_grafana_admin_password }}
disable_initial_admin_creation = false

[users]
allow_sign_up = false

[analytics]
reporting_enabled = false
check_for_updates = false

[log]
mode = console
level = info

[paths]
provisioning = /etc/grafana/provisioning
