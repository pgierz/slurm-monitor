{
  "uid": "albedo-scheduler",
  "title": "Albedo / Scheduler internals",
  "tags": ["albedo", "slurm", "scheduler"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "albedo-prom" },
        "hide": 2
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(slurm_scheduler_cycle_last_microseconds, cluster)",
        "refresh": 2,
        "current": { "text": "albedo", "value": "albedo" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Main cycle (last)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "slurm_scheduler_cycle_last_microseconds{cluster=\"$cluster\"}", "legendFormat": "main", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "µs" } }
    },
    {
      "type": "timeseries",
      "title": "Backfill cycle (last)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "slurm_backfill_cycle_last_microseconds{cluster=\"$cluster\"}", "legendFormat": "backfill", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "µs" } }
    },
    {
      "type": "timeseries",
      "title": "Backfill last depth",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "slurm_backfill_last_depth{cluster=\"$cluster\"}", "legendFormat": "depth", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs started/completed per minute",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "60 * rate(slurm_jobs_started_total{cluster=\"$cluster\"}[5m])", "legendFormat": "started/min", "refId": "A" },
        { "expr": "60 * rate(slurm_jobs_completed_total{cluster=\"$cluster\"}[5m])", "legendFormat": "completed/min", "refId": "B" }
      ]
    },
    {
      "type": "stat",
      "title": "Exporter health",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max by (collector) (time() - slurm_monitor_collector_last_success_timestamp_seconds{cluster=\"$cluster\"})",
          "legendFormat": "{{collector}} age",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      }
    }
  ]
}
