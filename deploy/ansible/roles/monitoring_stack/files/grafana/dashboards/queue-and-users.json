{
  "uid": "albedo-queue",
  "title": "Albedo / Queue & users",
  "tags": ["albedo", "slurm", "queue"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-12h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "albedo-prom" },
        "hide": 2
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(slurm_jobs, cluster)",
        "refresh": 2,
        "current": { "text": "albedo", "value": "albedo" }
      },
      {
        "name": "partition",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(slurm_jobs{cluster=\"$cluster\"}, partition)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Pending by reason",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(10, sum by (reason) (slurm_jobs_pending_by_reason{cluster=\"$cluster\", partition=~\"$partition\"}))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Longest current pending wait (per partition)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "max by (partition) (slurm_jobs_wait_seconds_max{cluster=\"$cluster\", partition=~\"$partition\"})",
          "legendFormat": "{{partition}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "bargauge",
      "title": "Top users by allocated CPUs",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(15, sum by (user) (slurm_jobs_cpus{cluster=\"$cluster\", state=\"RUNNING\", partition=~\"$partition\"}))",
          "legendFormat": "{{user}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "type": "bargauge",
      "title": "Top users by allocated GPUs",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(15, sum by (user) (slurm_jobs_gpus{cluster=\"$cluster\", state=\"RUNNING\", partition=~\"$partition\"}) > 0)",
          "legendFormat": "{{user}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "type": "table",
      "title": "Pending jobs by user/account",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (account, user, partition, qos) (slurm_jobs{cluster=\"$cluster\", state=\"PENDING\", partition=~\"$partition\"})",
          "legendFormat": "pending",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ]
    }
  ]
}
