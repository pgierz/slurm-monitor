// Copy to Signing.xcconfig (git-ignored) and fill in your team identifier,
// then run `xcodegen` again. A free personal team is enough for installing
// on your own device. Find the identifier in Xcode > Settings > Accounts,
// or in the Apple developer portal under Membership details.
DEVELOPMENT_TEAM = ABCDE12345

// Only if the identifier de.awi.slurm-monitor is already claimed by another
// team: choose your own base. The bundle identifiers, the app group and the
// keychain group all follow from it.
